---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.vue';
import Snowfall from '../components/Snowfall.vue';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Hans Naufal Granito — AI/ML Engineer & Software Developer. Portfolio showcasing machine learning, cloud-native development, and AI infrastructure skills." />
    <title>Hans Naufal Granito — AI/ML Engineer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="font-sans antialiased text-slate-900 bg-white dark:text-slate-100 dark:bg-slate-900">
    <nav class="sticky top-0 z-50 bg-white/95 dark:bg-slate-900/95 backdrop-blur border-b border-slate-200 dark:border-slate-700">
      <div class="max-w-5xl mx-auto flex items-center justify-end px-6 py-3">
        <ThemeToggle client:load />
      </div>
    </nav>
    <Snowfall client:load />
    <div class="relative z-[1]">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }
</style>
